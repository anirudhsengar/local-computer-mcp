[Unit]
Description=Local Computer MCP Secure Tunnel
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# Generated by scripts/ops.sh install-service; do not install this template directly.
# The trailing /. preserves paths ending in spaces or backslashes.
WorkingDirectory=@PROJECT_DIRECTORY@/.
Environment="LOCAL_COMPUTER_MCP_NODE=@NODE_EXECUTABLE@"
ExecStart=/usr/bin/bash scripts/ops.sh tunnel-run
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
